{
  "name": "kawai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force",
    "lint": "biome check frontend/src",
    "lint:fix": "biome check --write frontend/src",
    "format": "biome format --write frontend/src",
    "test": "vitest run",
    "preview": "vite preview",
    "generate:events": "cargo run -p kawai-bindings --manifest-path crates/Cargo.toml --bin export-bindings",
    "tauri": "bash scripts/tauri.sh",
    "tauri:dev:litert": "bash scripts/tauri.sh dev",
    "bundle:litert": "bash scripts/bundle-litert-dylibs.sh",
    "tauri:build:litert": "bash scripts/bundle-litert-dylibs.sh && tauri build -- --features litert --config .github/tauri-litert.json",
    "tauri:build:litert-office": "bash scripts/bundle-litert-dylibs.sh && tauri build -- --features litert,office --config .github/tauri-litert.json",
    "jscpd": "jscpd frontend/src --config .jscpd.json --reporters console"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@rive-app/react-webgl2": "^4.32.0",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "~2.4",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-opener": "~2.5",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "embla-carousel-react": "^8.6.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "html-url-attributes": "^3.0.1",
    "katex": "0.18.4",
    "lucide-react": "^1.31.0",
    "marked": "18.0.10",
    "media-chrome": "^4.19.2",
    "mermaid": "11.16.1",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-jsx-parser": "^2.4.1",
    "rehype-harden": "^1.1.8",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/d3-force": "^3.0.10",
    "@types/hast": "3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "@types/hast": "3.0.4"
  }
}
