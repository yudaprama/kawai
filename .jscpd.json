{
  "minLines": 5,
  "formats": ["rust"],
  "minTokens": 50,
  "reporters": ["console-full", "html", "json"],
  "output": "./jscpd-report-rust",
  "threshold": 2,
  "ignore": [
    "**/lib/streamdown/**",
    "**/components/ai-elements/**",
    "**/components/ui/**",
    "**/features/assets/components/asset/**",
    "**/assets/*.svg",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/AGENTS.md",
    "**/DESIGN.md",
    "**/generated-tools/**/*.gen.rs",
    "**/vendor/**",
    "**/target/**",
    "**/node_modules/**",
    "**/*_pb.rs",
    "**/*.pb.rs",
    "**/*.gen.rs"
  ]
}
