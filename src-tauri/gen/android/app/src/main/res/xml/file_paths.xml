<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <external-path name="my_images" path="." />
  <cache-path name="my_cache_images" path="." />
  <!-- App self-update APKs: logic::update downloads to <data_root>/updates/
       (= the app files dir on Android) and update_installer hands the file to
       the system installer through this provider. -->
  <files-path name="updates" path="updates/" />
</paths>
